    col1, col2 = st.columns(2)
    col1.metric("Under-Served %", f"{data['UnderServed'].mean()*100:.1f}%")
    col2.metric("Avg Visits (Under-Served)", f"{data.loc[data['UnderServed']==1,'NumWebVisitsMonth'].mean():.1f}")
    st.dataframe(data[["Age","Income","Marital_Status","Country","UnderServed"]].head())

