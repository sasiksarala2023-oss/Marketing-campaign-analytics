import streamlit as st
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# --- Load & Prepare Data ---
data = pd.read_csv("marketing_campaign_data.csv")
data["Dt_Customer"] = pd.to_datetime(data["Dt_Customer"])
data["Age"] = 2026 - data["Year_Birth"]
data["Children"] = data["Kidhome"] + data["Teenhome"]
data["Total_Spend"] = data[["MntWines","MntFruits","MntMeatProducts",
                            "MntFishProducts","MntSweetProducts","MntGoldProds"]].sum(axis=1)
data["Total_Purchases"] = data[["NumDealsPurchases","NumWebPurchases",
                                "NumCatalogPurchases","NumStorePurchases"]].sum(axis=1)

# --- Dashboard Title ---
st.title("📈 Marketing Campaign Analytics Dashboard")

# --- Tabs for Business Use Cases ---
tab1, tab2, tab3, tab4, tab5 = st.tabs([
    "Campaign Response Rates",
    "Spending Patterns",
    "Channel Usage",
    "Under-Served Segments",
    "Ideal Target Customers"
])

# --- Tab 1: Campaign Response Rates ---
with tab1:
    st.header("📌 Campaign Response Rates")
    response_rate = data["Response"].mean() * 100
    st.metric("Overall Response Rate", f"{response_rate:.1f}%")
    fig, ax = plt.subplots()
    sns.barplot(x="Marital_Status", y="Response", data=data, ax=ax)
    ax.set_title("Response Rate by Marital Status")
    st.pyplot(fig)

# --- Tab 2: Spending Patterns ---
with tab2:
    st.header("🍷 Spending Patterns Across Products")
    avg_spend = data["Total_Spend"].mean()
    st.metric("Average Total Spend", f"${avg_spend:,.0f}")
    spend_cols = ["MntWines","MntFruits","MntMeatProducts",
                  "MntFishProducts","MntSweetProducts","MntGoldProds"]
    fig, ax = plt.subplots()
    data[spend_cols].mean().plot(kind="bar", ax=ax)
    ax.set_title("Average Spend per Product Category")
    st.pyplot(fig)

# --- Tab 3: Channel Usage ---
with tab3:
    st.header("🛒 Channel Usage by High-Value Customers")
    threshold = data["Total_Spend"].quantile(0.9)
    data["HighSpender"] = np.where(data["Total_Spend"] > threshold, 1, 0)
    avg_web_visits = data["NumWebVisitsMonth"].mean()
    st.metric("Avg Monthly Web Visits", f"{avg_web_visits:.1f}")
    fig, ax = plt.subplots()
    sns.barplot(data=data, x="HighSpender", y="NumWebPurchases", ax=ax)
    ax.set_title("Web Purchases by High Spenders")
    st.pyplot(fig)

# --- Tab 4: Under-Served Segments ---
with tab4:
    st.header("⚠️ Under-Served Segments")
    data["UnderServed"] = np.where((data["Total_Spend"] < 1000) &
                                   (data["NumWebVisitsMonth"] > 10) &
                                   (data["Response"] == 0), 1, 0)
    underserved_pct = data["UnderServed"].mean() * 100
    st.metric("Under-Served Customers", f"{underserved_pct:.1f}%")
    st.dataframe(data[["Age","Income","Marital_Status","Country","UnderServed"]].head())

# --- Tab 5: Ideal Target Customers ---
with tab5:
    st.header("🎯 Ideal Target Customer Profile")
    ideal = data[(data["Response"] == 1) & (data["Total_Spend"] > data["Total_Spend"].quantile(0.75))]
    st.metric("Avg Age", f"{ideal['Age'].mean():.1f}")
    st.metric("Avg Income", f"${ideal['Income'].mean():,.0f}")
    st.write("Top Countries:", ideal["Country"].value_counts().head())
with tab1:
    st.header("📌 Campaign Response Rates")
    # KPI row
    col1, col2, col3 = st.columns(3)
    col1.metric("Overall Response Rate", f"{data['Response'].mean()*100:.1f}%")
    col2.metric("Campaign 1 Acceptance", f"{data['AcceptedCmp1'].mean()*100:.1f}%")
    col3.metric("Campaign 5 Acceptance", f"{data['AcceptedCmp5'].mean()*100:.1f}%")
    # Chart
    fig, ax = plt.subplots()
    sns.barplot(x="Marital_Status", y="Response", data=data, ax=ax)
    ax.set_title("Response Rate by Marital Status")
    st.pyplot(fig)

with tab2:
    st.header("🍷 Spending Patterns Across Products")
    # KPI row
    col1, col2, col3 = st.columns(3)
    col1.metric("Avg Wine Spend", f"${data['MntWines'].mean():,.0f}")
    col2.metric("Avg Meat Spend", f"${data['MntMeatProducts'].mean():,.0f}")
    col3.metric("Avg Gold Spend", f"${data['MntGoldProds'].mean():,.0f}")
    # Chart
    spend_cols = ["MntWines","MntFruits","MntMeatProducts",
                  "MntFishProducts","MntSweetProducts","MntGoldProds"]
    fig, ax = plt.subplots()
