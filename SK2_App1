import streamlit as st
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

# Load dataset
data = pd.read_csv("marketing_campaign_data.csv")
data["Dt_Customer"] = pd.to_datetime(data["Dt_Customer"])
data["Age"] = 2026 - data["Year_Birth"]
data["Children"] = data["Kidhome"] + data["Teenhome"]
data["Total_Spend"] = data[["MntWines","MntFruits","MntMeatProducts",
                            "MntFishProducts","MntSweetProducts","MntGoldProds"]].sum(axis=1)
data["Total_Purchases"] = data[["NumDealsPurchases","NumWebPurchases",
                                "NumCatalogPurchases","NumStorePurchases"]].sum(axis=1)

# Segmentation
data["HighIncome"] = np.where(data["Income"] > 75000, 1, 0)
data["YoungCustomer"] = np.where(data["Age"] < 30, 1, 0)
data["Responder"] = data["Response"]
data["HighWebEngagement"] = np.where(data["NumWebVisitsMonth"] > 5, 1, 0)
data["FamilyCustomer"] = np.where(data["Children"] > 0, 1, 0)
threshold = data["Total_Spend"].quantile(0.9)
data["HighSpender"] = np.where(data["Total_Spend"] > threshold, 1, 0)

# Streamlit UI
st.title("Marketing Campaign Analytics Dashboard")

# Filters
st.sidebar.header("Filters")
age_band = st.sidebar.selectbox("Select Age Band", ["All","<30","30-50",">50"])
income_band = st.sidebar.selectbox("Select Income Band", ["All","<50k","50k-75k",">75k"])

filtered = data.copy()

# Apply Age filter
if age_band == "<30":
    filtered = filtered[filtered["Age"] < 30]
elif age_band == "30-50":
    filtered = filtered[(filtered["Age"] >= 30) & (filtered["Age"] <= 50)]
elif age_band == ">50":
    filtered = filtered[filtered["Age"] > 50]

# Apply Income filter
if income_band == "<50k":
    filtered = filtered[filtered["Income"] < 50000]
elif income_band == "50k-75k":
    filtered = filtered[(filtered["Income"] >= 50000) & (filtered["Income"] <= 75000)]
elif income_band == ">75k":
    filtered = filtered[filtered["Income"] > 75000]

# Age Distribution
st.subheader("Age Distribution")
fig, ax = plt.subplots()
sns.histplot(filtered["Age"], bins=30, kde=True, ax=ax)
ax.set_title("Customer Age Distribution")
st.pyplot(fig)

# Income Distribution
st.subheader("Income Distribution")
fig, ax = plt.subplots()
sns.histplot(filtered["Income"], bins=30, kde=True, ax=ax)
ax.set_title("Income Distribution")
st.pyplot(fig)

# Spending Patterns
st.subheader("Average Spend per Product Category")
spend_cols = ["MntWines","MntFruits","MntMeatProducts",
              "MntFishProducts","MntSweetProducts","MntGoldProds"]
fig, ax = plt.subplots()
filtered[spend_cols].mean().plot(kind="bar", ax=ax)
ax.set_title("Average Spend per Product Category")
st.pyplot(fig)

# Response vs Income
st.subheader("Income vs Campaign Response")
fig, ax = plt.subplots()
sns.boxplot(x="Response", y="Income", data=filtered, ax=ax)
ax.set_title("Income vs Campaign Response")
st.pyplot(fig)

# KPI Table
st.subheader("Segment KPIs")
segment_summary = filtered.groupby("HighIncome")[["Total_Spend","Response"]].mean()
st.dataframe(segment_summary)
